# Copy this file to ".env" and fill in real values.

# PostgreSQL (Neon). Two URLs from your Neon/Vercel Postgres dashboard:
#   DATABASE_URL = the POOLED connection string (has "-pooler" in the host)
#   DIRECT_URL   = the DIRECT connection string (no "-pooler"), used for migrations
# Both should include "?sslmode=require".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/wikiciv?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/wikiciv?sslmode=require"

# Secret used to sign session cookies. Use a long random value in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

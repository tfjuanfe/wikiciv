# Copy this file to ".env" and fill in real values.

# Local dev uses SQLite (the default below). For production (e.g. Vercel),
# set this to a Postgres connection string AND change the datasource provider
# in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Use a long random value in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"
